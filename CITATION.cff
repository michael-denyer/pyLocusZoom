    given-names: Michael
    email: code.denyer@gmail.com
version: 3.1.1
date-released: 2026-09-08
license: GPL-3.0-or-later
repository-code: https://github.com/michael-denyer/pyLocusZoom
url: https://github.com/michael-denyer/pyLocusZoom
keywords:
