# Matrix for tlc-matrix.sh. Each `run` is one TLC run of the spec above it
# with the CONSTANTS after the bar. Names is a set of naturals; the shipped
# canine map set has 38 names. Readers are the writers that go on to load a
# map. Every run in this file passes.

# Strict claims: the cache path starts absent, as a regular file, or as a
# directory holding any subset of the map set, a stray map and a foreign entry.
spec RecombPublish.tla
check INVARIANTS TypeOK StagingOwned NoLeak SinglePublisher WriterSucceeds FailsOnlyWhenInjected Converges NeverWritesThroughSymlink CheckedNeverClobbers
check INVARIANTS NoGap StaysComplete NoUndocumentedError ValidationJustified
check PROPERTIES Termination
run strict writers=1 names=1 | Writers={w1} Readers={w1} Names={1} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run strict writers=1 names=2 | Writers={w1} Readers={} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run strict writers=2 names=1 | Writers={w1,w2} Readers={w1} Names={1} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run strict writers=2 names=2 | Writers={w1,w2} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run strict writers=2 names=3 | Writers={w1,w2} Readers={w1} Names={1,2,3} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run strict writers=2 both-read | Writers={w1,w2} Readers={w1,w2} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run strict writers=3 names=1 | Writers={w1,w2,w3} Readers={w1} Names={1} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run strict writers=3 names=2 | Writers={w1,w2,w3} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
# Boundary starts on their own.
run strict start=absent | Writers={w1,w2} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"absent"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run strict start=file | Writers={w1,w2} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"file"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
# Failure injection: the download or extraction raises, or the archive is short.
run strict failat=one | Writers={w1,w2} Readers={w2} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={w1} ShortAt={} Sticky=FALSE ExtSteps=0
run strict failat=all | Writers={w1,w2} Readers={w2} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={w1,w2} ShortAt={} Sticky=FALSE ExtSteps=0
run strict shortat=one | Writers={w1,w2} Readers={w2} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={w1} Sticky=FALSE ExtSteps=0
run strict writers=3 failat=one shortat=one | Writers={w1,w2,w3} Readers={w3} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir"} Modes={"ensure","force"} FailAt={w1} ShortAt={w2} Sticky=FALSE ExtSteps=0

# Legacy symlink starts: a symlink to a directory with any contents, or a
# dangling symlink. NoUndocumentedError and ValidationJustified hold as they
# do above. NoGap and StaysComplete hold here only until a writer unlinks the
# symlink, so their *Unless* forms are checked.
# RecombPublishLegacySymlink.tla below pins the failure itself.
spec RecombPublish.tla
check INVARIANTS TypeOK StagingOwned NoLeak SinglePublisher WriterSucceeds FailsOnlyWhenInjected Converges NeverWritesThroughSymlink CheckedNeverClobbers
check INVARIANTS NoGapUnlessSwapped StaysCompleteUnlessSwapping NoUndocumentedError ValidationJustified
check PROPERTIES Termination
run legacy writers=1 names=2 | Writers={w1} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"symlink","dangling"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run legacy writers=2 names=1 | Writers={w1,w2} Readers={w1} Names={1} Stray=s Other=o InitKinds={"absent","file","dir","symlink","dangling"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run legacy writers=2 names=2 | Writers={w1,w2} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"absent","file","dir","symlink","dangling"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run legacy writers=3 names=2 | Writers={w1,w2,w3} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"symlink","dangling"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
run legacy failat=one shortat=one | Writers={w1,w2,w3} Readers={w3} Names={1,2} Stray=s Other=o InitKinds={"symlink","dangling"} Modes={"ensure","force"} FailAt={w1} ShortAt={w2} Sticky=FALSE ExtSteps=0
# The symlink cannot be unlinked (sticky cache parent, link owned by another user).
run legacy sticky writers=2 | Writers={w1,w2} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"symlink","dangling"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=TRUE ExtSteps=0

# An external actor deletes cache entries and removes the emptied directory
# while writers run. Publication may then raise and the cache may end
# incomplete, so only ownership, cleanup and termination are claimed.
spec RecombPublish.tla
check INVARIANTS TypeOK StagingOwned NoLeak FailsOnlyWhenInjected NeverWritesThroughSymlink CheckedNeverClobbers
check PROPERTIES Termination
run external steps=2 names=1 | Writers={w1,w2} Readers={w1} Names={1} Stray=s Other=o InitKinds={"absent","dir"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=2
run external steps=3 names=2 | Writers={w1,w2} Readers={w1} Names={1,2} Stray=s Other=o InitKinds={"absent","dir"} Modes={"ensure","force"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=3

# Expected failure, pinned as a witness. The run passes while the named
# failure of a strict claim is still reachable from a legacy symlink start.
spec RecombPublishLegacySymlink.tla
check INVARIANTS TypeOK
check PROPERTIES Witnessed
run expected-failure gap NoGap | Writers={w1,w2} Readers={w1} W1=w1 W2=w2 Names={1,2} Stray=s Other=o InitKinds={"symlink"} Modes={"ensure","force","checked","forcechecked"} FailAt={} ShortAt={} Sticky=FALSE ExtSteps=0
