# TLC matrix for the staged cache protocols. Run with tlc-matrix.sh.
# Process names are strings; a set-valued constant has no spaces.

# --- chain_lifter: every claim holds in every run, whatever the source
# returns. A download is parsed before it is published, so no configuration
# needs a weaker set of claims.
spec StagedCache.tla
check INVARIANTS TypeOK PartOwnership PartNeverVanishes NoLeak DestNeverPartial LifterGood
check INVARIANTS NoGoodUnlink NoSpuriousFailure CachedLifterServed PublishedParses QuiescentClean
check PROPERTIES Termination
# The source never returns corrupt content.
run chain p=1 init=absent | Procs={"a"} Calls=1 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=1 init=good | Procs={"a"} Calls=1 InitDest="good" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=1 init=corrupt | Procs={"a"} Calls=1 InitDest="corrupt" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=2 init=absent | Procs={"a","b"} Calls=1 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=2 init=corrupt | Procs={"a","b"} Calls=1 InitDest="corrupt" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=3 init=absent | Procs={"a","b","c"} Calls=1 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=3 init=corrupt | Procs={"a","b","c"} Calls=1 InitDest="corrupt" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=2 calls=2 init=absent | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="none"
# Download failures at each point where the code can raise.
run chain p=2 init=absent fail=a@create | Procs={"a","b"} Calls=1 InitDest="absent" FailProcs={"a"} FailDl={1} FailStage="create" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=2 init=corrupt fail=a@stream | Procs={"a","b"} Calls=1 InitDest="corrupt" FailProcs={"a"} FailDl={1} FailStage="stream" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=2 init=absent fail=all@replace | Procs={"a","b"} Calls=1 InitDest="absent" FailProcs={"a","b"} FailDl={1} FailStage="replace" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=3 init=corrupt fail=ab@stream | Procs={"a","b","c"} Calls=1 InitDest="corrupt" FailProcs={"a","b"} FailDl={1} FailStage="stream" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=2 calls=2 init=absent fail=a@stream dl=1,2 | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={"a"} FailDl={1,2} FailStage="stream" CorruptProcs={} CorruptDl={} Damage="none"
run chain p=2 calls=2 init=corrupt fail=a@stream dl=2 | Procs={"a","b"} Calls=2 InitDest="corrupt" FailProcs={"a"} FailDl={2} FailStage="stream" CorruptProcs={} CorruptDl={} Damage="none"
# The source returns content that does not parse (captive portal, proxy error page).
run chain-corrupt p=1 all corrupt | Procs={"a"} Calls=1 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"a"} CorruptDl={1} Damage="none"
run chain-corrupt p=1 calls=2 first corrupt | Procs={"a"} Calls=2 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"a"} CorruptDl={1} Damage="none"
run chain-corrupt p=2 b corrupt init=absent | Procs={"a","b"} Calls=1 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"b"} CorruptDl={1} Damage="none"
run chain-corrupt p=2 b corrupt init=good | Procs={"a","b"} Calls=1 InitDest="good" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"b"} CorruptDl={1} Damage="none"
run chain-corrupt p=2 all corrupt init=corrupt | Procs={"a","b"} Calls=1 InitDest="corrupt" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"a","b"} CorruptDl={1} Damage="none"
run chain-corrupt p=3 bc corrupt init=corrupt | Procs={"a","b","c"} Calls=1 InitDest="corrupt" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"b","c"} CorruptDl={1} Damage="none"
run chain-corrupt p=2 calls=2 b corrupt | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"b"} CorruptDl={1,2} Damage="none"
# Corrupt content together with a raising download.
run chain-corrupt-fail p=2 calls=2 corrupt=1 fail=2@stream | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={"a","b"} FailDl={2} FailStage="stream" CorruptProcs={"a","b"} CorruptDl={1} Damage="none"
run chain-corrupt-fail p=3 b corrupt a fails@replace | Procs={"a","b","c"} Calls=1 InitDest="corrupt" FailProcs={"a"} FailDl={1} FailStage="replace" CorruptProcs={"b"} CorruptDl={1} Damage="none"
run chain-corrupt-fail p=2 calls=2 b corrupt a fails dl=2 | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={"a"} FailDl={2} FailStage="stream" CorruptProcs={"b"} CorruptDl={1,2} Damage="none"
# The cached file is removed or damaged from outside, once, at any moment.
run chain-damage p=2 calls=2 absent | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="absent"
run chain-damage p=2 calls=2 corrupt init=good | Procs={"a","b"} Calls=2 InitDest="good" FailProcs={} FailDl={} FailStage="none" CorruptProcs={} CorruptDl={} Damage="corrupt"
run chain-damage p=2 calls=2 absent a fails dl=2 | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={"a"} FailDl={2} FailStage="stream" CorruptProcs={} CorruptDl={} Damage="absent"
run chain-damage p=2 calls=2 corrupt b corrupt | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"b"} CorruptDl={1,2} Damage="corrupt"
run chain-damage p=3 absent b corrupt init=good | Procs={"a","b","c"} Calls=1 InitDest="good" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"b"} CorruptDl={1} Damage="absent"
# The configurations in which the code reached a bad state before downloads
# were parsed ahead of publication. Each was a fixed-interleaving witness;
# every interleaving is now checked and the bad state is unreachable.
#   unlinkGood     a process removed a good chain another had published,
#                  and that process then raised DataDownloadError.
#   corruptLeft    a corrupt first download stayed on disk when the next raised.
#   cachedIgnored  a process holding a lifter raised because the file was
#                  gone and its re-download failed.
run unreachable unlinkGood | Procs={"a","b"} Calls=1 InitDest="corrupt" FailProcs={} FailDl={} FailStage="none" CorruptProcs={"b"} CorruptDl={1} Damage="none"
run unreachable corruptLeft | Procs={"a"} Calls=2 InitDest="absent" FailProcs={"a"} FailDl={2} FailStage="stream" CorruptProcs={"a"} CorruptDl={1} Damage="none"
run unreachable cachedIgnored | Procs={"a","b"} Calls=2 InitDest="absent" FailProcs={"a"} FailDl={2} FailStage="stream" CorruptProcs={"b"} CorruptDl={1,2} Damage="absent"

# --- Gene cache: get-or-fetch callers against a clear_cache deleter.
spec StagedGeneCache.tla
check INVARIANTS TypeOK PartOwnership NoLeak DestNeverPartial ReaderSeesWhole
check INVARIANTS SaveLostOnlyOnFault QuiescentClean
check PROPERTIES Termination
run gene g=0 c=1 init=good | Getters={} Clearers={"x"} InitDest="good" FailProcs={} FailStage="none"
run gene g=1 c=0 init=absent | Getters={"a"} Clearers={} InitDest="absent" FailProcs={} FailStage="none"
run gene g=1 c=1 init=good | Getters={"a"} Clearers={"x"} InitDest="good" FailProcs={} FailStage="none"
run gene g=2 c=1 init=absent | Getters={"a","b"} Clearers={"x"} InitDest="absent" FailProcs={} FailStage="none"
run gene g=2 c=1 init=corrupt | Getters={"a","b"} Clearers={"x"} InitDest="corrupt" FailProcs={} FailStage="none"
run gene g=3 c=1 init=good | Getters={"a","b","c"} Clearers={"x"} InitDest="good" FailProcs={} FailStage="none"
run gene g=3 c=1 init=absent | Getters={"a","b","c"} Clearers={"x"} InitDest="absent" FailProcs={} FailStage="none"
run gene g=2 c=2 init=good | Getters={"a","b"} Clearers={"x","y"} InitDest="good" FailProcs={} FailStage="none"
run gene g=2 c=1 fail=a@fetch | Getters={"a","b"} Clearers={"x"} InitDest="absent" FailProcs={"a"} FailStage="fetch"
run gene g=2 c=1 fail=a@create | Getters={"a","b"} Clearers={"x"} InitDest="absent" FailProcs={"a"} FailStage="create"
run gene g=2 c=1 fail=a@write | Getters={"a","b"} Clearers={"x"} InitDest="corrupt" FailProcs={"a"} FailStage="write"
run gene g=3 c=1 fail=all@write | Getters={"a","b","c"} Clearers={"x"} InitDest="absent" FailProcs={"a","b","c"} FailStage="write"
run gene g=2 c=1 fail=all@replace | Getters={"a","b"} Clearers={"x"} InitDest="good" FailProcs={"a","b"} FailStage="replace"
